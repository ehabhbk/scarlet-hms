[Unit]
Description=Scarlet HMS UDP/Syslog device listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/scarlet-hms
ExecStart=/usr/bin/php /var/www/scarlet-hms/artisan devices:listen-udp --host=0.0.0.0 --port=2578 --kind=clinical
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
